.calendar-box.data-v-327935f0 {
	--bg-primary: #FFFFFF;
	--bg-secondary: #FFFFFF;
	--text-primary: #333333;
	--text-secondary: #666666;
	--text-disabled: #999999;
	--date-text: #333333;
	--theme-color: #FF871E;
	--theme-border: #FF871E;
	--button-text: #FFFFFF;
	--supplement-bg: transparent;
	--supplement-border: #FF871E;
}
/* CSS变量 - 暗色主题 */
.calendar-box.dark-theme.data-v-327935f0 {
	--bg-primary: #1a1a1a;
	--bg-secondary: #2d2d2d;
	--text-primary: #ffffff;
	--text-secondary: #e0e0e0;
	--text-disabled: #999999;
	--date-text: #ffffff;
	--theme-color: #ffc470;
	--theme-border: #ffc470;
	--button-text: #ffffff;
	--supplement-bg: rgba(255, 196, 112, 0.1);
	--supplement-border: rgba(255, 196, 112, 0.3);
}
.calendar-box.data-v-327935f0 {
	width: 100%;
	flex-direction: column;
	justify-content: center;
}
.miss_box.data-v-327935f0 {
	width: 100%;
	padding: 20rpx 40rpx;
	box-sizing: border-box;
	background-color: var(--bg-primary);
	border-radius: 25rpx;
}
.calendar-box.data-v-327935f0,
.month.data-v-327935f0,
.week.data-v-327935f0,
.day.data-v-327935f0 {
	display: flex;
	align-items: center;
	justify-content: space-between;
}
.week.data-v-327935f0, .day.data-v-327935f0 {
	display: grid;
	grid-template-columns: repeat(7, 1fr); /* 一行7列，每列等宽 */
}
.month.data-v-327935f0,
.week.data-v-327935f0,
.day.data-v-327935f0 {
	width: 100%;
}
.month.data-v-327935f0 {
	margin: 30rpx 0;
	position: relative;
	color: var(--text-primary);
}
.picker.data-v-327935f0 {
	width: 160rpx;
	height: 40rpx;
	position: absolute;
	top: 20rpx;
	left: 50%;
	-webkit-transform: translate(-50%, -50%);
	        transform: translate(-50%, -50%);
}
.day.data-v-327935f0 {
	flex-wrap: wrap;
}
.week>view.data-v-327935f0,
.day>view.data-v-327935f0 {
	width: 70rpx;
	height: 70rpx;
	margin: 10rpx;
	text-align: center;
	position: relative;
	line-height: 70rpx;
	color: var(--date-text);
}
.checkday.data-v-327935f0 {
	color: var(--text-disabled);
}
.choose.data-v-327935f0 {
	color: var(--button-text);
	border-radius: 50%;
}
.circle.data-v-327935f0 {
	width: 10rpx;
	height: 10rpx;
	border-radius: 50%;
	position: absolute;
	bottom: 10%;
	left: 50%;
	-webkit-transform: translate(-50%, -50%);
	        transform: translate(-50%, -50%);
}
.sign.data-v-327935f0 {
	background-color: var(--bg-primary);
}
.repair.data-v-327935f0 {
	background-color: var(--bg-primary);
}
.but.data-v-327935f0 {
	display: flex;
	flex: 1;
	margin-top: 80rpx;
	justify-content: center;
}
.but button.data-v-327935f0 {
	width: 650rpx;
	height: 80rpx;
	line-height: 80rpx;
	border-radius: 30rpx;
	border: 1px solid transparent;
	outline: none;
	color: var(--button-text);
	font-size: 32rpx;
}
uni-button.data-v-327935f0:after {
	border: none;
}
.top.data-v-327935f0 {
	display: flex;
	width: 100%;
	justify-content: space-between;
	padding: 30rpx;
	box-sizing: border-box;
	background-color: var(--bg-secondary);
	border-radius: 20rpx;
	margin-bottom: 16rpx;
	align-items: center;
}
.top ._h4.data-v-327935f0 {
	font-weight: 600;
	font-size: 36rpx;
	line-height: 50rpx;
	color: var(--text-primary);
}
.top ._h4 ._span.data-v-327935f0 {
	color: var(--theme-color);
	margin: 0 10rpx;
	font-size: 32rpx
}
.top ._p.data-v-327935f0 {
	font-style: normal;
	font-weight: normal;
	font-size: 28rpx;
	line-height: 40rpx;
	color: var(--theme-color);
}
.right ._span.data-v-327935f0 {
	font-style: normal;
	font-weight: normal;
	font-size: 24rpx;
	line-height: 48rpx;
	color: var(--theme-color);
	border: 1px solid var(--supplement-border);
	background: var(--supplement-bg);
	padding: 10rpx 20rpx;
	border-radius: 32rpx;
	transition: background-color 0.2s ease;
}
.month .previous.data-v-327935f0 {
	min-width: 35px;
}


<view class="{{['calendar-box','data-v-327935f0',(darkMode)?'dark-theme':'']}}"><view class="top data-v-327935f0"><view class="data-v-327935f0"><view class="_h4 data-v-327935f0">已连续签到<label class="_span data-v-327935f0">{{''+checkinDays+''}}</label>天</view><block wx:if="{{isIntegral}}"><view class="_p data-v-327935f0">{{"今日获得+"+integral+"积分"}}</view></block></view><view class="right data-v-327935f0"><block wx:if="{{supplementary}}"><label data-event-opts="{{[['tap',[['shift',['$event']]]]]}}" bindtap="__e" class="_span data-v-327935f0">补签</label></block></view></view><view class="miss_box data-v-327935f0"><view class="month data-v-327935f0"><view data-event-opts="{{[['tap',[['lastMonth',['$event']]]]]}}" class="previous data-v-327935f0" bindtap="__e"><label hidden="{{!(showPrevious)}}" class="_span data-v-327935f0">上月</label></view><view class="data-v-327935f0">{{year+"年"+month+"月"}}</view><view data-event-opts="{{[['tap',[['nextMonth',['$event']]]]]}}" class="previous data-v-327935f0" bindtap="__e"><label hidden="{{!(showNext)}}" class="_span data-v-327935f0">下月</label></view><block wx:if="{{checkDate}}"><picker class="picker data-v-327935f0" mode="date" fields="month" data-event-opts="{{[['change',[['changeDate',['$event']]]]]}}" bindchange="__e"></picker></block></view><view class="week data-v-327935f0"><block wx:for="{{weekArr}}" wx:for-item="weeks" wx:for-index="__i0__"><view style="{{('color:'+(weeks==currentWeek?bgweek:'')+';')}}" class="data-v-327935f0">{{weeks}}</view></block></view><view class="day data-v-327935f0"><block wx:for="{{dayArr}}" wx:for-item="days" wx:for-index="index" wx:key="index"><view data-event-opts="{{[['tap',[['signToday',['$0',index],[[['dayArr','',index]]]]]]]}}" class="{{['data-v-327935f0',[(days.date=='')?'checkday':''],[(days.date==localDate||days.flag)?'choose':'']]}}" style="{{('background:'+(days.date==localDate||days.flag?bgday:'')+';')}}" bindtap="__e">{{''+days.day+''}}<view class="{{['data-v-327935f0',[(days.flag)?'circle':'